# zathura — rice "Mucha" (PDF com atalhos de vim)
set font "Alegreya Sans 12"
set selection-clipboard clipboard
set adjust-open "width"
set window-title-basename true
set guioptions "s"

set default-bg "#F7F1E3"
set default-fg "#3A3328"
set statusbar-bg "#EFE6D2"
set statusbar-fg "#3A3328"
set inputbar-bg "#EFE6D2"
set inputbar-fg "#3A3328"
set notification-bg "#EFE6D2"
set notification-fg "#3A3328"
set notification-error-bg "#8A4B26"
set notification-error-fg "#F7F1E3"
set notification-warning-bg "#B8955A"
set notification-warning-fg "#3A3328"
set highlight-color "rgba(184,149,90,0.45)"
set highlight-active-color "rgba(176,104,58,0.55)"
set completion-bg "#EFE6D2"
set completion-fg "#3A3328"
set completion-highlight-bg "#DCE3D2"
set completion-highlight-fg "#3A3328"
set index-bg "#F7F1E3"
set index-fg "#3A3328"
set index-active-bg "#DCE3D2"
set index-active-fg "#3A3328"

# modo leitura (Ctrl+R): papel creme em vez de branco puro
set recolor-lightcolor "#F7F1E3"
set recolor-darkcolor "#3A3328"
set recolor-keephue true
