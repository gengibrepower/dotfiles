# Ghostty — rice Art Nouveau "Mucha"
# Paleta: ~/Projects/dotfiles/hypr/mucha.lua

font-family = Maple Mono NF
font-size = 14

window-padding-x = 6
window-padding-y = 4
window-padding-balance = true
window-decoration = none
gtk-titlebar = false
confirm-close-surface = false

# translucidez (sem blur)
background-opacity = 0.80
# sem blur: o wallpaper aparece nítido atrás do texto
background-blur = false

background = #F7F1E3
foreground = #3A3328
cursor-color = #3A3328
cursor-text = #F7F1E3
selection-background = #DCE3D2
selection-foreground = #3A3328

# preto, vermelho, verde, amarelo, azul, magenta, ciano, branco
palette = 0=#3A3328
palette = 1=#8A4B26
palette = 2=#4F5E45
palette = 3=#8F6A2C
palette = 4=#4E6470
palette = 5=#7A4E5E
palette = 6=#4D6B62
palette = 7=#E2D7BF
palette = 8=#6E6553
palette = 9=#B0683A
palette = 10=#6B7D5E
palette = 11=#B8955A
palette = 12=#6A8290
palette = 13=#9A6A7A
palette = 14=#6A8A80
palette = 15=#EFE6D2

# Super+V do Hyprland manda Shift+Insert: colar do clipboard, não da seleção
keybind = shift+insert=paste_from_clipboard

# padding acompanha a cor das células da borda (nvim escuro sem moldura creme)
window-padding-color = extend-always

# Alt+1..9 fica para o tmux (abas do tmux, não do Ghostty)
keybind = alt+1=unbind
keybind = alt+digit_1=unbind
keybind = alt+2=unbind
keybind = alt+digit_2=unbind
keybind = alt+3=unbind
keybind = alt+digit_3=unbind
keybind = alt+4=unbind
keybind = alt+digit_4=unbind
keybind = alt+5=unbind
keybind = alt+digit_5=unbind
keybind = alt+6=unbind
keybind = alt+digit_6=unbind
keybind = alt+7=unbind
keybind = alt+digit_7=unbind
keybind = alt+8=unbind
keybind = alt+digit_8=unbind
keybind = alt+9=unbind
keybind = alt+digit_9=unbind
