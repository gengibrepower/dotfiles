// Zed — editor secundário, espelhando o nvim (LazyVim + gruvbox dark hard)
{
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Dark Hard"
  },
  "vim_mode": true,
  "vim": {
    // LazyVim usa clipboard=unnamedplus
    "use_system_clipboard": "always",
    "use_smartcase_find": true
  },
  "relative_line_numbers": "disabled",
  "cursor_blink": false,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 18,
  "ui_font_family": "Alegreya Sans",
  "ui_font_size": 16,
  "terminal": {
    "font_family": "Maple Mono NF",
    "font_size": 15
  },
  // mesma guia do nvim: código até a coluna 100
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "tab_size": 2,
  "format_on_save": "off",
  "scrollbar": { "show": "never" },
  // árvore na esquerda, como o neo-tree do LazyVim
  "project_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "tab_bar": { "show": false },
  "toolbar": { "breadcrumbs": true, "quick_actions": false },
  "inlay_hints": { "enabled": true },
  "telemetry": { "diagnostics": false, "metrics": false }
}
