[user]
	name = Felipe Gegembauer
	email = 79603683+gengibrepower@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[difftool]
	prompt = false
[pager]
	difftool = true
[alias]
	dft = difftool --tool=difftastic
[rerere]
	enabled = true
[rebase]
	autosquash = true
	autostash = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
